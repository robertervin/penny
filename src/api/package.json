{
  "name": "@penny/api",
  "version": "0.1.0",
  "private": true,
  "description": "Penny HTTP API (Plaid Link, Situation, Memory)",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "npm run build -w @penny/core",
    "start": "node dist/index.js",
    "predev": "npm run build -w @penny/core",
    "dev": "tsx --env-file=../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@penny/core": "*",
    "@hono/node-server": "^1.19.17",
    "@hono/zod-validator": "^0.4.3",
    "hono": "^4.13.4",
    "plaid": "^30.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
