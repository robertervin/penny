# Example env for running Penny services locally.

AWS_REGION=us-east-2
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
EVENT_BUS_NAME=penny
WORKFLOW_QUEUE_URL=http://localhost:4566/000000000000/penny-workflow
PAYLOAD_BUCKET=penny-plaid-snapshots
DATABASE_URL=postgres://penny:penny@localhost:5432/penny

# Plaid (set PLAID_STUB=false and add keys for real Link)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_STUB=false
PLAID_ENV=sandbox

# Plaid Link API (HTTP)
API_PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
PENNY_API_URL=http://localhost:3001

TOKEN_ENCRYPTION_KEY=local-dev-only-not-for-prod
LOG_LEVEL=info
WORKER_CONCURRENCY=2

# SMS gateway (explore + execute over text)
SMS_PORT=3002
SMS_DEV_MODE=true
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Bind inbound dev SMS to your household (from Link UI / bootstrap)
# PENNY_DEV_HOUSEHOLD_ID=
# PENNY_DEV_PERSON_ID=

# penny-mcp (Cursor / ChatGPT Explore)
# PENNY_HOUSEHOLD_ID=
# PENNY_PERSON_ID=
