{
  "name": "@penny/workflow-processor",
  "version": "0.1.0",
  "private": true,
  "description": "Penny background workflow processor (SQS → EventBridge-routed workflows)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx --env-file=.env src/index.ts",
    "api:dev": "tsx --env-file=.env src/api/index.ts",
    "api:start": "node dist/api/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx --env-file=.env src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-eventbridge": "^3.787.0",
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/client-sqs": "^3.787.0",
    "@hono/node-server": "^1.19.17",
    "@hono/zod-validator": "^0.4.3",
    "hono": "^4.13.4",
    "pg": "^8.14.1",
    "pino": "^9.6.0",
    "plaid": "^30.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
