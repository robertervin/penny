{
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "terminals": [
    {
      "name": "api",
      "command": "npm run api:dev"
    },
    {
      "name": "workflow-processor",
      "command": "npm run processor:dev"
    },
    {
      "name": "sms-gateway",
      "command": "npm run sms:dev"
    },
    {
      "name": "mfb-prototype",
      "command": "cd tools/mfb-prototype && npm install && npm run dev -- --host 0.0.0.0 --port 5173"
    }
  ],
  "ports": [
    {
      "name": "mfb-prototype",
      "port": 5173
    },
    {
      "name": "link-ui",
      "port": 5174
    },
    {
      "name": "api",
      "port": 3001
    },
    {
      "name": "sms-gateway",
      "port": 3002
    }
  ]
}
